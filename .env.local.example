# Copie ce fichier en .env.local et remplis les valeurs

# URL de ton site (domaine custom ou URL Vercel).
# Ne PAS mettre https://la-parenthese.vercel.app : ce sous-domaine est pris par
# un autre restaurant du même nom, à Sète.
NEXT_PUBLIC_SITE_URL=https://la-parenthese-nu.vercel.app

# Formspree — crée un compte sur formspree.io, puis récupère l'ID du formulaire
NEXT_PUBLIC_FORMSPREE_ID=

# Le jeton Google Search Console n'est PAS ici : il est public et permanent,
# donc écrit en dur dans app/layout.tsx (champ `verification`).
